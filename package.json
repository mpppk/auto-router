{
	"name": "auto-router",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc -p . && tsc -p test && tsc -p eval && tsc -p scripts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "bun test",
		"check:types": "wrangler types --check",
		"build": "wrangler deploy --dry-run --outdir dist",
		"eval:semantic": "bun eval/run-semantic.ts",
		"eval:routing": "bun eval/run-routing.ts",
		"smoke": "bun scripts/smoke.ts"
	},
	"dependencies": {
		"hono": "^4.13.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/bun": "^1.4.2",
		"openai": "^7.23.0",
		"typescript": "^7.0.2",
		"wrangler": "^4.137.0"
	}
}
