{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auto-router",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-23",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			// routing trace の保存先 (#7)
			"binding": "TRACES_DB",
			"database_name": "auto-router-traces",
			"database_id": "f17b80b6-1289-4fc1-b375-5af1eddfa435",
			"migrations_dir": "migrations"
		}
	],
	// Jev 呼び出し / D1 書き込みの abuse 抑止 (#19)。period を変えたら src/app.ts の RATE_LIMIT_PERIOD_SECONDS も合わせる。
	"ratelimits": [
		{
			// client IP (CF-Connecting-IP) 単位
			"name": "RATE_LIMIT_IP",
			"namespace_id": "1001",
			"simple": { "limit": 300, "period": 60 }
		},
		{
			// API key fingerprint 単位
			"name": "RATE_LIMIT_KEY",
			"namespace_id": "1002",
			"simple": { "limit": 120, "period": 60 }
		}
	],
	"kv_namespaces": [
		{
			// cron で縮約した OpenRouter model catalog (#20)
			"binding": "CATALOG_KV",
			"id": "5078fa1b4e3b45719637376fe4c846f8"
		}
	],
	"triggers": {
		// 期限切れ routing trace の削除 / model catalog の更新 (src/index.ts と合わせる)
		"crons": ["17 3 * * *", "7 * * * *"]
	}
}
